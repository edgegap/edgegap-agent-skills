# Copy to .env next to docker-compose.yml. Never commit .env: it holds the
# Edgegap API token, which controls the whole Edgegap organization.

# Edgegap dashboard > User Settings > Tokens. Keep the "token " prefix.
EDGEGAP_API_TOKEN=token <your-edgegap-api-token>
# The Edgegap application, and the version Nakama deploys until you change it
# with the update_edgegap_version RPC.
EDGEGAP_APPLICATION=<app-name>
INITIAL_EDGEGAP_VERSION=<version-name>
# The port name in that app version (the one clients connect to).
EDGEGAP_PORT_NAME=gameport

# Public https URL of this Nakama (no trailing slash). Edgegap servers call it
# back, so localhost won't do: use your Nakama host, Heroic Cloud's URL, or a
# tunnel to port 7350 for testing.
NAKAMA_ACCESS_URL=https://your-nakama.example.com
# Server-to-server key. Game servers receive it inside their callback URLs.
NAKAMA_HTTP_KEY=<long-random-string>
